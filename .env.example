# ─── Volt configuration ───────────────────────────────────────────────
# Copy to .env (scripts/setup.sh does this and fills the secrets for you).

# SQLite database (path is relative to prisma/schema.prisma → ./data/volt.db)
DATABASE_URL="file:../data/volt.db"
# Where the built-in signing key and other runtime data live
DATA_DIR="./data"

# Auth.js
AUTH_SECRET=""                     # openssl rand -base64 32  (setup.sh generates it)
AUTH_URL="https://volt.example.com"   # public URL of the app (also used in notification links)
SESSION_HOURS=12

# Microsoft Entra ID (scripts/entra-register.sh creates the app registration and fills these)
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""  # https://login.microsoftonline.com/<tenant-id>/v2.0/

# Workspace bootstrap
WORKSPACE_NAME="My Company"
WORKSPACE_SLUG="default"
ADMIN_EMAILS="admin@example.com"   # comma separated; always get the ADMIN role
ALLOWED_EMAIL_DOMAINS="example.com" # users from these domains may sign in; what they see is set in Admin → General → Access (default: nothing until an admin grants access)

# Development only — never enabled when NODE_ENV=production
AUTH_DEV_LOGIN="false"

# Built-in digital signature key (Ed25519, PEM). Leave empty to auto-generate into DATA_DIR.
SIGNING_PRIVATE_KEY=""
SIGNING_PUBLIC_KEY=""

# Optional e-mail: notifications (enable in Administration → General) and sign-in links for external users.
# Either Amazon SES …
AWS_REGION="eu-west-1"
SES_FROM_EMAIL="noreply@example.com"
# … or any SMTP server (wins over SES when set), e.g. Microsoft 365: smtp://user%40example.com:password@smtp.office365.com:587
SMTP_URL=""
MAIL_FROM="Volt <noreply@example.com>"
# Public address of the app, used in emailed links
APP_URL="https://volt.example.com"
VOLT_DATA_DIR="/opt/volt/data"
VOLT_IMAGE="ghcr.io/your-org/volt:latest"
VOLT_DOMAIN="volt.example.com"           # public host name served by Caddy (HTTPS certificate)

# Database backups to S3 (off without a bucket). Credentials: AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY or an instance role. See docs/BACKUPS.md.
BACKUP_S3_BUCKET=""
BACKUP_S3_PREFIX="volt/"
BACKUP_INTERVAL_HOURS="6"
BACKUP_KEEP_DAYS="30"
# BACKUP_S3_REGION="eu-west-1"
# BACKUP_S3_KMS_KEY_ID=""
# BACKUP_INCLUDE_SIGNING_KEY="1"

# AI element drawing (Library → New element → "Describe or sketch"). Off when the key is empty.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1"              # any OpenAI model with image input + structured outputs (also used by the AI reviewer)
# OPENAI_BASE_URL="https://api.openai.com/v1"   # optional: proxy / compatible endpoint
