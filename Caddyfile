volt.example.com {
    encode zstd gzip
    # largest upload is an 80 MB library archive; anything bigger never reaches the app
    request_body {
        max_size 100MB
    }
    # live collaboration streams (Server-Sent Events) must not be buffered
    reverse_proxy volt:3000 {
        flush_interval -1
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
        -X-Powered-By
    }
}
